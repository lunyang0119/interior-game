# Copy to server/.env (gitignored) on the VM.
SHEET_URL=https://script.google.com/macros/s/XXXXXXXX/exec
IP_SALT=change-me-to-a-long-random-string
DB_PATH=/opt/interior/server/interior.db
# Leave SHEET_URL empty to use FAKE_SHEET_PATH (defaults to data/fake_sheet.json) for local dev.
DUCKDNS_TOKEN=your-duckdns-token
