# Copy to server/.env (gitignored) on the VM.
SHEET_URL=https://script.google.com/macros/s/XXXXXXXX/exec
IP_SALT=change-me-to-a-long-random-string
DB_PATH=/opt/interior/server/interior.db
# Leave SHEET_URL empty to use FAKE_SHEET_PATH (defaults to data/fake_sheet.json) for local dev.
DUCKDNS_TOKEN=your-duckdns-token

# Train minigame (/train/), server/app/train. All optional.
# Binds the caller of POST /api/train/claim as admin; empty = claiming disabled.
TRAIN_ADMIN_SECRET=
# Discord webhook: two lines per game (combat mode on, capture). Empty = off.
TRAIN_WEBHOOK_URL=
# Overrides of the engine tuning / extra maps (defaults: data/train_config.json, data/train_maps.json).
#TRAIN_CONFIG_PATH=/opt/interior/data/train_config.json
#TRAIN_MAPS_PATH=/opt/interior/data/train_maps.json
# Gemini key for the AI crew / AI fugitive. Needs `pip install -e .` on the VM (google-genai). Empty = AI buttons hidden.
GEMINI_API_KEY=
#FUGITIVE_GEMINI_MODEL=
#FUGITIVE_GEMINI_FALLBACK_MODELS=
#FUGITIVE_GEMINI_RETRIES=3
#FUGITIVE_GEMINI_RETRY_BASE_SEC=2
